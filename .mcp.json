{
  "mcpServers": {
    "godot-mcp-toolkit": {
      "command": "npx",
      "args": ["-y", "@npgamedev/godot-mcp-server@1.1.2"],
      "env": {
        "GODOT_MCP_CONFIG_VERSION": "1",
        "npm_config_prefer_offline": "true"
      }
    },
    "godot-cli": {
      "command": "npx",
      "args": ["-y", "@coding-solo/godot-mcp@0.1.1"],
      "env": {
        "GODOT_PATH": "/Applications/Godot.app/Contents/MacOS/Godot"
      }
    }
  }
}
