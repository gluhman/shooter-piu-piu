; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="shoot-container"
config/version="1.4.0"
run/main_scene="res://game/ui/startup/startup_splash.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.039, 0.055, 0.047, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://game/ui/startup/shooter_boot.png"
config/icon="res://assets/menu/icon.svg"

[autoload]

ShooterRelease="*res://game/release/shooter_release.gd"
Net="*res://game/network/net.gd"
RoomDirectory="*res://game/network/room_directory.gd"
GameSettings="*res://game/settings/game_settings.gd"
MenuFeedback="*res://game/ui/menu_feedback.gd"
PhantomCameraManager="*res://game/ui/round_camera_manager.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/sky_3d/plugin.cfg", "res://addons/godot_mcp_toolkit/plugin.cfg", "res://addons/gut/plugin.cfg", "res://addons/road-generator/plugin.cfg", "res://addons/vfx_animaiton_player/plugin.cfg")

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Movement capsules"
3d_physics/layer_3="Combat hurtboxes"
3d_physics/layer_4="Grenade projectiles"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
