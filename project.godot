; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="shoot-container"
run/main_scene="res://game/match/arena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/menu/icon.svg"

[autoload]

Net="*res://game/network/net.gd"
RoomDirectory="*res://game/network/room_directory.gd"
GameSettings="*res://game/settings/game_settings.gd"
MenuFeedback="*res://game/ui/menu_feedback.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/sky_3d/plugin.cfg")

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Movement capsules"
3d_physics/layer_3="Combat hurtboxes"
3d_physics/layer_4="Grenade projectiles"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
